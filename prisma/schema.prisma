model ProductList {
  id                   Int          @id @default(autoincrement())
  product_name         String
  price                Float
  upload_date_time     DateTime     @default(now())
  image                String?
  images               String?
  description          String?
  product_status       String
  category_table_id    Int
  subcategory_table_id Int?
  user_id              Int
  category             Category     @relation(fields: [category_table_id], references: [id])
  subcategory          Subcategory? @relation(fields: [subcategory_table_id], references: [id], onDelete: SetNull)
  user                 User         @relation(fields: [user_id], references: [id])
  conversations        Conversation[]
  favorites            Favorite[]
  transactions         Transaction[]
  reports              ProductReport[]
}
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  }

model User {
  id        Int           @id @default(autoincrement())
  email     String?       @unique
  name      String?
  address   String?
  addressHouseNo String?
  addressStreetNo String?
  addressArea String?
  addressCity String?
  addressPostalCode String?
  addressCountry String?
  referralCode String?    @unique
  referredById Int?
  sellerRatingAvg Float @default(0)
  sellerRatingCount Int @default(0)
  password  String?
  googleId   String?      @unique
  facebookId String?      @unique
  phone      String?      @unique
  phoneVerifiedAt DateTime?
  phoneVerificationCodeHash String?
  phoneVerificationExpiresAt DateTime?
  phoneVerificationAttempts Int @default(0)
  user_type String        @default("user")
  status    String        @default("active")
  emailVerifiedAt DateTime?
  emailVerificationCodeHash String?
  emailVerificationExpiresAt DateTime?
  emailVerificationAttempts Int @default(0)
  createdAt DateTime      @default(now())
  referredBy User?        @relation("UserReferrals", fields: [referredById], references: [id])
  referrals  User[]       @relation("UserReferrals")
  products  ProductList[]
  favorites Favorite[]
  buyerConversations Conversation[]    @relation("BuyerConversations")
  sellerConversations Conversation[]   @relation("SellerConversations")
  sentMessages       ConversationMessage[] @relation("SentMessages")
  buyerTransactions  Transaction[]         @relation("BuyerTransactions")
  sellerTransactions Transaction[]         @relation("SellerTransactions")
  reports            ProductReport[]
  reportsReceived    ProductReport[]      @relation("SellerReports")
  ratingsGiven       SellerRating[]        @relation("BuyerGivenRatings")
  ratingsReceived    SellerRating[]        @relation("SellerReceivedRatings")
  notifications      UserNotification[]
  sellerFeatures     SellerFeature[]

  @@index([createdAt])
  @@index([referredById])
}

model SellerFeature {
  id           Int      @id @default(autoincrement())
  sellerId      Int
  placement    String
  durationDays Int
  startsAt     DateTime @default(now())
  endsAt       DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  seller       User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, placement])
  @@index([placement, endsAt])
  @@index([sellerId, endsAt])
}

model NotificationCampaign {
  id            Int                @id @default(autoincrement())
  title         String
  body          String
  deepLink      String?
  audienceType  String
  audienceValue String?
  createdAt     DateTime           @default(now())
  recipients    UserNotification[]

  @@index([createdAt])
  @@index([audienceType, createdAt])
}

model UserNotification {
  id         Int                  @id @default(autoincrement())
  userId     Int
  campaignId Int
  title      String
  body       String
  deepLink   String?
  isRead     Boolean              @default(false)
  readAt     DateTime?
  createdAt  DateTime             @default(now())
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@index([userId, isRead, createdAt])
  @@index([campaignId, createdAt])
}

model SellerRating {
  id        Int      @id @default(autoincrement())
  buyerId   Int
  sellerId  Int
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  buyer     User     @relation("BuyerGivenRatings", fields: [buyerId], references: [id], onDelete: Cascade)
  seller    User     @relation("SellerReceivedRatings", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([buyerId, sellerId])
  @@index([sellerId, createdAt])
}

model ProductReport {
  id          Int         @id @default(autoincrement())
  listingId   Int?
  sellerId    Int?
  reporterId  Int
  reportType  String
  details     String?
  imageUrl    String?
  status      String      @default("open")
  priority    String      @default("medium")
  actionTaken String?
  adminNote   String?
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  listing     ProductList? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller      User?       @relation("SellerReports", fields: [sellerId], references: [id], onDelete: Cascade)
  reporter    User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([sellerId, status])
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
}

model Category {
  id            Int           @id @default(autoincrement())
  category_name String        @unique
  subcategories Subcategory[]
  products      ProductList[]
}

model Subcategory {
  id                Int           @id @default(autoincrement())
  subcategory_name  String
  category_table_id Int
  category          Category      @relation(fields: [category_table_id], references: [id], onDelete: Cascade)
  products          ProductList[]

  @@unique([category_table_id, subcategory_name])
}

model Conversation {
  id         Int                   @id @default(autoincrement())
  listingId  Int
  buyerId    Int
  sellerId   Int
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  listing    ProductList           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer      User                  @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller     User                  @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages   ConversationMessage[]
  transaction Transaction?

  @@unique([listingId, buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([updatedAt])
}

model Transaction {
  id                      Int          @id @default(autoincrement())
  conversationId          Int          @unique
  listingId               Int
  buyerId                 Int
  sellerId                Int
  agreedAmount            Decimal      @db.Decimal(12, 2)
  commissionRate          Decimal      @db.Decimal(5, 4)
  platformFeeAmount       Decimal      @db.Decimal(12, 2)
  sellerNetAmount         Decimal      @db.Decimal(12, 2)
  status                  String       @default("pending_confirmation")
  feePaymentStatus        String       @default("unpaid")
  buyerAmountConfirmedAt  DateTime?
  sellerAmountConfirmedAt DateTime?
  buyerCompletedAt        DateTime?
  sellerCompletedAt       DateTime?
  completedAt             DateTime?
  voidedAt                DateTime?
  feePaymentMethod        String?
  feePaymentReference     String?
  feeProofImageUrl        String?
  feePaidAt               DateTime?
  feeVerifiedAt           DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  conversation            Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  listing                 ProductList  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer                   User         @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  seller                  User         @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([status, completedAt])
  @@index([feePaymentStatus, feePaidAt])
  @@index([sellerId, status])
  @@index([buyerId, status])
}

model ConversationMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  body           String
  imageUrl       String?
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([readAt])
}

model Favorite {
  id        Int         @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   ProductList @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}
